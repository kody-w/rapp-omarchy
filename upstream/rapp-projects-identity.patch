+def test_new_project_identity_uses_declared_owner_and_uuid4(tmp_path, monkeypatch):
+    seed = uuid.UUID("dfffe932-3ba0-4ff0-a76c-a451db115c24")
+    monkeypatch.setattr("rapp_projects.core.uuid.uuid4", lambda: seed)
+    store = ProjectStore(tmp_path / "control")
+    open_project(store)
+    identity = json.loads((store.project_path("alpha") / "rappid.json").read_text())
+    expected = hashlib.sha256(b"rapp/1:rappid\n" + seed.bytes).hexdigest()
+    assert identity["rappid"] == f"rappid:@example/alpha:{expected}"
+    reopened = ProjectStore(tmp_path / "control")
+    assert reopened.frames("alpha")[0]["stream_id"] == identity["rappid"]
+
+
+@pytest.mark.parametrize("entropy", [b"", b"arbitrary seed", b"\x00" * 16, b"\x00" * 32])
+def test_open_refuses_non_uuid4_entropy_before_creating_project(tmp_path, entropy):
+    store = ProjectStore(tmp_path / "control")
+    with pytest.raises(ProjectError, match="invalid project identity"):
+        store.open("alpha", title="Alpha", goal="Test", owner="example", origin="test", entropy=entropy)
+    assert not store.project_path("alpha").exists()
+
